{
	"schemaVersion": 1,
	"id": "afterburner_labs",
	"version": "${version}",
	"name": "Afterburner Labs",
	"description": "Afterburner's experimental parts: a shader pack loader, upscaling and far terrain. The shader pack loader and upscaling stay off with Sodium or Iris.",
	"authors": [
		"Hamdan"
	],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.afterburner.labs.Labs"
		],
		"client": [
			"com.afterburner.labs.LabsClient"
		],
		"afterburner": [
			"com.afterburner.labs.LabsAddon"
		]
	},
	"mixins": [
		{
			"config": "afterburner_labs.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"afterburner": "*",
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}
