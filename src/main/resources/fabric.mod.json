{
	"schemaVersion": 1,
	"id": "afterburner",
	"version": "${version}",
	"name": "Afterburner",
	"description": "Makes Minecraft run faster.",
	"authors": [
		"Hamdan"
	],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.afterburner.Afterburner"
		],
		"client": [
			"com.afterburner.client.AfterburnerClient"
		],
		"sodium:config_api_user": [
			"com.afterburner.client.gui.SodiumSettingsPage"
		]
	},
	"mixins": [
		"afterburner.mixins.json",
		{
			"config": "afterburner.client.mixins.json",
			"environment": "client"
		}
	],
	"accessWidener": "afterburner.accesswidener",
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-lifecycle-events-v1": "*",
		"fabric-command-api-v2": "*"
	}
}
